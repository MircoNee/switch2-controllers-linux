# ngc BLE bridge IMU evdev nodes (INPUT_PROP_ACCELEROMETER) need session ACL
# like joysticks. Fedora's uaccess rules only tag ID_INPUT_JOYSTICK, not accel.
SUBSYSTEM=="input", ENV{PHYS}=="ngc/*", ENV{ID_INPUT_ACCELEROMETER}=="1", TAG+="uaccess"

# Native Switch Pro HID emulation uses /dev/uhid for Steam Input gyro.
KERNEL=="uhid", SUBSYSTEM=="misc", TAG+="uaccess"
